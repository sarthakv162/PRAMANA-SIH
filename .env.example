# PostgreSQL owner used only for role provisioning and Alembic migrations.
POSTGRES_USER=pramana
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=pramana

# Runtime and ingestion logins are created by backend/app/core/bootstrap_db.py.
# Use URL-safe random values (for example: openssl rand -hex 24).
APP_DB_PASSWORD=replace-with-a-different-long-random-url-safe-password
INGEST_DB_PASSWORD=replace-with-another-long-random-url-safe-password
DATABASE_URL=postgresql+psycopg://pramana_app:replace-with-a-different-long-random-url-safe-password@localhost:5432/pramana
DATABASE_URL_ADMIN=postgresql+psycopg://pramana:replace-with-a-long-random-url-safe-password@localhost:5432/pramana
INGEST_DATABASE_URL=postgresql+psycopg://ingest_rw:replace-with-another-long-random-url-safe-password@localhost:5432/pramana

RERANK=0
RERANK_SKIP_MARGIN=0.15
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_TAU_HIGH=0.80
NLI_TAU_LOW=0.50
TAU_ABSTAIN=0.35
TAU_REVIEW=0.60
CONFIDENCE_W_RETRIEVAL_MARGIN=0.25
CONFIDENCE_W_MEAN_ENTAIL=0.25
CONFIDENCE_W_VERIFIED_RATIO=0.25
CONFIDENCE_W_BACK_TRANSLATION=0.25

# Prototype controls. MOCK_MODE=1 serves clearly marked fixture-backed API responses.
DEMO_KEY=replace-with-a-random-admin-access-key
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_S=60
FIXTURES_DIR=../contracts/fixtures

# Compose serves the frontend at http://localhost:8080 and proxies /v1 to the backend.
VITE_API_MODE=live

# Local inference only. Native Ollama; Docker overrides its address to host.docker.internal.
LLM_MODEL=qwen3:4b
EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_KEEP_ALIVE=5m
TRANSLATE_PROVIDER=llm
MOCK_MODE=0
# Public judging deployment only: open shared history/case files without a workspace key.
PUBLIC_DEMO_MODE=0
# Optional CPU thread limit for hosted inference. Native Mac inference uses its defaults.
# OLLAMA_NUM_THREADS=2
REQUEST_DEADLINE_S=180
MEMORY_BUDGET_GB=12
WORKSPACE_ID=shared-demo
HISTORY_RETENTION_DAYS=30

# Sarvam is used only for explicit answer read-aloud, not text inference/translation.
# Keep this key on the backend; never add a VITE_ speech key.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_TIMEOUT_S=60
